{
  "name": "sentinel",
  "version": "1.77.23",
  "description": "Sentinel - Remote Monitoring and Management",
  "author": "Sentinel",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "agent:build": "cd agent && powershell -ExecutionPolicy Bypass -File build.ps1 -Platform all",
    "agent:build:win": "cd agent && powershell -ExecutionPolicy Bypass -File build.ps1 -Platform windows",
    "agent:build:linux": "cd agent && powershell -ExecutionPolicy Bypass -File build.ps1 -Platform linux",
    "agent:build:macos": "cd agent && powershell -ExecutionPolicy Bypass -File build.ps1 -Platform macos",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "sync-version": "node scripts/sync-version.js",
    "release:agent": "npm run sync-version && npm run agent:build:win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api-tests",
    "test:e2e:ui": "playwright test --project=e2e-tests"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@simplewebauthn/browser": "^10.0.0",
    "@tanstack/react-query": "^5.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.303.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.21.1",
    "recharts": "^2.10.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.0.10",
    "vitest": "^4.0.16",
    "ws": "^8.20.0",
    "zustand": "^4.4.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohio15/Sentinel.git"
  }
}
