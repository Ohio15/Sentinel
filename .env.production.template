# Sentinel RMM Platform - Production Environment Configuration
# Copy this file to .env and update with your production values

# =============================================================================
# Domain Configuration (REQUIRED)
# =============================================================================
# Your production domain - must point to your server's public IP
DOMAIN=sentinel.yourdomain.com

# Environment
SERVER_ENV=production

# =============================================================================
# Database Configuration (REQUIRED - generate secure passwords!)
# =============================================================================
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=GENERATE_A_SECURE_64_CHAR_PASSWORD_HERE
POSTGRES_DB=sentinel
DB_SSL_MODE=prefer

# =============================================================================
# Redis Configuration (REQUIRED - generate secure password!)
# =============================================================================
# Exactly 64 lowercase hex characters: openssl rand -hex 32
# Compose has NO default for this - an unset value fails the stack closed rather
# than silently starting Redis on a known password.
# This value is consumed twice: by the backend (REDIS_URL) and by
# configs/redis/redis.conf, which scripts/generate-redis-conf.sh renders on the
# host. Regenerate that file whenever this changes.
REDIS_PASSWORD=GENERATE_A_SECURE_64_CHAR_PASSWORD_HERE

# =============================================================================
# Security Configuration (REQUIRED - generate secure values!)
# =============================================================================
# JWT Secret - at least 64 characters, use: openssl rand -hex 32
JWT_SECRET=GENERATE_A_SECURE_64_CHAR_JWT_SECRET_HERE

# Enrollment Token - UUID format, use: uuidgen or online generator
ENROLLMENT_TOKEN=GENERATE_A_NEW_UUID_HERE

# API Key for Electron app authentication - use: openssl rand -hex 32
API_KEY=GENERATE_A_SECURE_64_CHAR_API_KEY_HERE

# =============================================================================
# TLS/SSL Configuration (REQUIRED for Let's Encrypt)
# =============================================================================
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@yourdomain.com

# =============================================================================
# mTLS Configuration
# =============================================================================
# Enable mTLS for agent connections (requires CA certificate setup)
MTLS_ENABLED=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# Server URL (for agents to connect)
# =============================================================================
# The public URL agents will use to connect
# For mTLS: use port 8443
SERVER_URL=https://sentinel.yourdomain.com:8443

# =============================================================================
# Metrics Configuration
# =============================================================================
METRICS_RETENTION_DAYS=30

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit this file with real values to version control
# 2. Use strong, unique passwords for each service
# 3. Keep your JWT_SECRET and API_KEY secure and never share them
# 4. Ensure your firewall only allows ports 80, 443, 8443, and 4444
# 5. Set up regular backups of the postgres-data volume
# 6. Monitor logs in agent-traefik-logs volume for security events
