{
  "annotations": { "list": [] },
  "description": "Sentinel RMM agent fleet health — primary operational dashboard. Drives connectivity / version / cert-expiry awareness from the sentinel_* metrics emitted by sentinel-backend on /metrics. See server/internal/api/metrics.go for the metric definitions.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Agents online",
      "id": 1,
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_agent_connected)",
          "legendFormat": "online"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Agents silent (>5 min)",
      "id": 2,
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sentinel_agent_last_seen_seconds > 300)",
          "legendFormat": "silent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Cert expiring (<14d)",
      "id": 3,
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sentinel_cert_expires_in_days < 14)",
          "legendFormat": "expiring"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Active WS connections",
      "id": 4,
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sentinel_websocket_active", "legendFormat": "ws" }
      ],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Legacy agents (<1.77.5)",
      "id": 8,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_agents_legacy_count)",
          "legendFormat": "legacy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "table",
      "title": "Connectivity by agent",
      "id": 5,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_agent_last_seen_seconds",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "__name__": true, "Time": true, "instance": true, "job": true, "agent_id": true },
            "renameByName": { "hostname": "Agent", "Value": "Last seen (sec)" },
            "indexByName": { "hostname": 0, "Value": 1 }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Last seen (sec)", "desc": false }] } }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "color-background-solid" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 900 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Last seen (sec)" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      }
    },
    {
      "type": "barchart",
      "title": "Version distribution",
      "id": 6,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (version) (sentinel_agent_version)",
          "legendFormat": "{{version}}",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal", "showValue": "auto", "stacking": "none" }
    },
    {
      "type": "table",
      "title": "Cert expiry watch",
      "id": 7,
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_cert_expires_in_days",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "__name__": true, "Time": true, "instance": true, "job": true, "agent_id": true },
            "renameByName": { "hostname": "Agent", "Value": "Days until expiry" },
            "indexByName": { "hostname": 0, "Value": 1 }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Days until expiry", "desc": false }] } }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "color-background-solid" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0 },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Days until expiry" },
            "properties": [{ "id": "unit", "value": "d" }]
          }
        ]
      }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["sentinel", "fleet", "agents"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Sentinel — Fleet Health",
  "uid": "sentinel-fleet-health",
  "version": 1,
  "weekStart": ""
}
