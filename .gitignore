# Dependencies
node_modules/

# Build output
dist/
release/

# Environment and config
.env
.env.local
.env.production
update-config.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Compiled Go binaries — built locally and via CI/CD; never commit.
# Per Ron's standing rule: binaries do not go in git. Local working copies
# are fine, but they must not be tracked. The size-guard pre-commit hook
# also catches accidental re-introduction.
*.exe
# Linux/macOS Go binaries (no .exe extension) — same standing rule.
installers/sentinel-agent-linux-*
installers/sentinel-agent-darwin-*
installers/sentinel-bootstrap-linux-*
installers/sentinel-bootstrap-darwin-*
installers/sentinel-verify-linux-*
installers/sentinel-verify-darwin-*
installers/sentinel-watchdog-darwin-*
# ...but the signed-manifest sidecars ARE tracked: they are small JSON, the
# update server serves them next to each binary, and they carry the release's
# audit record. The binary patterns above would otherwise swallow them.
!installers/*.manifest.json
# Legacy explicit entries (kept for clarity / if *.exe is ever narrowed):
downloads/sentinel-agent*
agent/sentinel-installer.exe

# Test output
test-results/

# TLS Certificates (never commit private keys!)
certs/*.key
certs/*.pem
certs/*.crt
certs/*.srl
certs/*.cnf
server/sentinel.exe
server/*.test.exe
*.test.exe
# Linux Go binaries (no .exe extension)
server/sentinel-server
server/sentinel-server-linux
server/sentinel-server-*
release/agent/sentinel-agent-*
# Private keys and certificates (global)
*.pem
*.key

# Backup files from API migration
*.bak

# Temporary fix scripts
fix-*.js
fix_*.ps1
check-service.ps1
cleanup_services.bat
update_main_ts.py
*.patch

# Screenshots
*.png

# --- Build/installer binaries & packages (standing rule: binaries never in git) ---
# Agent packages and watchdog binaries published to installers/ by the build,
# plus their timestamped backups. Source (scripts, specs, systemd units, docs)
# under installers/ stays tracked; only the built artifacts are ignored.
installers/*.pkg
installers/*.rpm
installers/*.deb
installers/*.spk
installers/sentinel-watchdog-linux-*

# Timestamped backups (broadens the existing *.bak to *.bak-<timestamp>)
*.bak-*
backups/

# Deprecated dnsmasq config (replaced by AdGuardHome on NEXUS)
configs/dnsmasq/

# openssl extension scratch files (certs/*.key|pem|crt|srl|cnf already ignored)
certs/*.ext
